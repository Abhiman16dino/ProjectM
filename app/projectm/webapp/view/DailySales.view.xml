<mvc:View
    controllerName="projectm.controller.DailySales"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page_daily_sales"
        title="{i18n>title} - Daily Sales"
    >
        <HBox
            id="_IDGenHBox1"
            justifyContent="End"
            width="100%"
        >
            <SegmentedButton
                id="viewToggle"
                selectedKey="both"
                width="250px"
                selectionChange=".onViewChange"
            >
                <items>
                    <SegmentedButtonItem
                        id="_IDGenSegmentedButtonItem"
                        key="table"
                        text="Table"
                    />
                    <SegmentedButtonItem
                        id="_IDGenSegmentedButtonItem1"
                        key="chart"
                        text="Chart"
                    />
                    <SegmentedButtonItem
                        id="_IDGenSegmentedButtonItem2"
                        key="both"
                        text="Both"
                    />
                </items>
            </SegmentedButton>
        </HBox>

        <viz:VizFrame
            id="salesChart"
            vizType="line"
            width="100%"
            height="400px"
            xmlns:viz="sap.viz.ui5.controls"
        />

        <Table
            id="idsalestable"
            items="{
			path: '/sales'
		}"
        >
            <columns>
                <Column id="_IDGenColumn">
                    <Text
                        id="_IDGenText1"
                        text="Date"
                    />
                </Column>
                <Column id="_IDGenColumn1">
                    <Text
                        id="_IDGenText2"
                        text="Sales"
                    />
                </Column>
            </columns>
            <items>
                <ColumnListItem
                    id="_IDGenColumnListItem"
                    vAlign="Middle"
                >
                    <cells>
                        <Text
                            id="_IDGenText3"
                            text="{date}"
                        />
                        <Text
                            id="_IDGenText4"
                            text="{sales}"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <footer>
            <OverflowToolbar id="otbFooter">
                <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                <OverflowToolbarButton
                    id="_IDGenOverflowToolbarButton"
                    tooltip="Add Entry"
                    text="Add"
                    icon="sap-icon://add-activity"
                    press=".onDefaultDialogPress"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>

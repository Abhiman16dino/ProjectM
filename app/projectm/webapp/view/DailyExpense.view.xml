<mvc:View
    controllerName="projectm.controller.DailyExpense"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        id="page_daily_expense"
        title="{i18n>title} - Daily Expense"
    >
        <HBox
            id="_IDGenHBox1_Exp"
            justifyContent="End"
            width="100%"
        >
            <SegmentedButton
                id="viewToggle_Exp"
                selectedKey="both"
                width="250px"
                selectionChange=".onViewChange"
            >
                <items>
                    <SegmentedButtonItem
                        id="_IDGenSegmentedButtonItem_Exp"
                        key="table"
                        text="Table"
                    />
                    <SegmentedButtonItem
                        id="_IDGenSegmentedButtonItem1_Exp"
                        key="chart"
                        text="Chart"
                    />
                    <SegmentedButtonItem
                        id="_IDGenSegmentedButtonItem2_Exp"
                        key="both"
                        text="Both"
                    />
                </items>
            </SegmentedButton>
        </HBox>

        <viz:VizFrame
            id="expenseChart"
            vizType="line"
            width="100%"
            height="400px"
            xmlns:viz="sap.viz.ui5.controls"
        />

        <Table
            id="idexpensetable"
            items="{
			path: '/expense'
		}"
        >
            <columns>
                <Column id="_IDGenColumn_Exp">
                    <Text
                        id="_IDGenText1_Exp"
                        text="Date"
                    />
                </Column>
                <Column id="_IDGenColumn1_Exp">
                    <Text
                        id="_IDGenText2_Exp"
                        text="Expense"
                    />
                </Column>
                <Column id="_IDGenColumn2_Exp">
                    <Text
                        id="_IDGenText_Exp"
                        text="Daily Staff"
                    />
                </Column>
                <Column id="_IDGenColumn2_Ex3">
                    <Text
                        id="_IDGenText_Ex3"
                        text="Total Expense"
                    />
                </Column>
            </columns>
            <items>
                <ColumnListItem
                    id="_IDGenColumnListItem_Exp"
                    vAlign="Middle"
                >
                    <cells>
                        <Text
                            id="_IDGenText3_Exp"
                            text="{date}"
                        />
                        <Text
                            id="_IDGenText4_Exp_1"
                            text="{expense}"
                        />
                        <Text
                            id="_IDGenText4_Exp"
                            text="{fixedStaffSalary}"
                        />
                        <Text
                            id="_total_Exp"
                            text="{totalExpense}"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
        <footer>
            <OverflowToolbar id="otbFooter_Exp">
                <ToolbarSpacer id="_IDGenToolbarSpacer1_Exp" />
                <OverflowToolbarButton
                    id="_IDGenOverflowToolbarButton_Exp"
                    tooltip="Add Entry"
                    text="Add"
                    icon="sap-icon://add-activity"
                    press=".onDefaultDialogPress"
                />
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
